# Copy this file to .env and fill in your own values. Never commit .env.

DATABASE_URL=sqlite:///./opportunities.db
SCRAPE_HOUR_UTC=6

# CORS -- BACKEND_CORS_ORIGINS is a JSON array (used as-is locally; in
# production, set it to your Vercel URL). BACKEND_CORS_ORIGIN_REGEX is
# optional and useful in production for matching Vercel's per-deployment
# preview URLs -- see DEPLOYMENT.md.
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# BACKEND_CORS_ORIGIN_REGEX=

# Email digest, sent via the Resend HTTP API (https://resend.com) -- not
# plain SMTP, since Render (and most PaaS free tiers) block outbound SMTP
# ports entirely. Leave RESEND_API_KEY blank to disable sending; the scraper
# still runs fine without email configured.
#
# 1. Sign up free at https://resend.com and create an API key.
# 2. Until you verify your own sending domain there, Resend's sandbox mode
#    only delivers to the email address you signed up with -- fine for
#    testing, but add a verified domain before adding real subscribers.
# 3. FROM_EMAIL defaults to Resend's shared sandbox address (works
#    out of the box); once you verify a domain, point it at your own address.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
