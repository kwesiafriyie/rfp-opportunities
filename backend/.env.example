# Copy this file to .env and fill in your own values. Never commit .env.

DATABASE_URL=sqlite:///./opportunities.db
SCRAPE_HOUR_UTC=6

# CORS -- BACKEND_CORS_ORIGINS is a JSON array (used as-is locally; in
# production, set it to your Vercel URL). BACKEND_CORS_ORIGIN_REGEX is
# optional and useful in production for matching Vercel's per-deployment
# preview URLs -- see DEPLOYMENT.md.
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# BACKEND_CORS_ORIGIN_REGEX=

# Email digest -- leave SMTP_USER / SMTP_PASSWORD blank to disable sending
# entirely (the scraper still runs fine without email configured).
#
# For Gmail: SMTP_USER is your full Gmail address, and SMTP_PASSWORD must be
# a 16-character App Password (requires 2-Step Verification enabled on the
# account) -- https://myaccount.google.com/apppasswords. Your normal Gmail
# login password will NOT work here and should never be used for this.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
