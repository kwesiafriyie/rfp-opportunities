# Copy this file to .env and fill in your own values. Never commit .env.

DATABASE_URL=sqlite:///./opportunities.db
SCRAPE_HOUR_UTC=6

# CORS -- BACKEND_CORS_ORIGINS is a JSON array (used as-is locally; in
# production, set it to your Vercel URL). BACKEND_CORS_ORIGIN_REGEX is
# optional and useful in production for matching Vercel's per-deployment
# preview URLs -- see DEPLOYMENT.md.
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# BACKEND_CORS_ORIGIN_REGEX=

# Email digest, sent via the SendGrid HTTP API (https://sendgrid.com) -- not
# plain SMTP, since Render (and most PaaS free tiers) block outbound SMTP
# ports entirely. Leave SENDGRID_API_KEY blank to disable sending; the
# scraper still runs fine without email configured.
#
# 1. Sign up free at https://sendgrid.com (100 emails/day free, forever).
# 2. Settings -> Sender Authentication -> verify a "Single Sender" -- this
#    is just your own email address (e.g. Gmail), confirmed by clicking a
#    link SendGrid emails you. No domain/DNS needed. Set FROM_EMAIL to that
#    exact address below.
# 3. Settings -> API Keys -> create one with "Mail Send" permission.
SENDGRID_API_KEY=
FROM_EMAIL=

# Shown in every digest email's footer -- required by anti-spam law
# (CAN-SPAM/CASL) for opt-in bulk email like this, and its absence also
# tends to hurt deliverability (spam filters look for it). Leave blank to
# omit, but that's not recommended.
MAILING_ADDRESS=

# This backend's own public URL (e.g. your Render service URL), used to
# build a one-click unsubscribe link in the digest footer. Leave blank to
# fall back to a plain-text note instead of a link.
BACKEND_PUBLIC_URL=
